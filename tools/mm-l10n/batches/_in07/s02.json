"key": "TXT_KEY_MAP_SCRIPT_ARCHIPELAGO_DESCR",
"en": "The ultimate water map for Civilization IV. Powerful navies not optional!"
},
{
"key": "TXT_KEY_MAP_SCRIPT_EARTH3_DESCR",
"en": "Derivative map generator that simulates a randomized Earth."
},
{
"key": "TXT_KEY_MAP_SCRIPT_EREBUS_DESCR",
"en": "Random map that creates a region of a fantasy type world where much of the world is unknown and irrelevant. It allows terrain to be created on a smaller, more detailed scale than planetary maps."
},
{
"key": "TXT_KEY_MAP_SCRIPT_FRACTURED_WORLD_DESCR",
"en": "Evolving plate tectonics map. When the eons come and go, the world slowly changes as the continents drift and break apart, and new islands are created that may be driven into the continents."
},
{
"key": "TXT_KEY_MAP_SCRIPT_INLAND_SEA_DESCR",
"en": "A large sea inhabits the center, surrounded by a thick ring of land."
},
{
"key": "TXT_KEY_MAP_SCRIPT_MEDIUM_AND_SMALL_DESCR",
"en": "Realistic world with highly random landmasses medium and small. East and west hemispheres are divided by ocean, although rarely an island chain may connect them."
},
{
"key": "TXT_KEY_MAP_SCRIPT_PANGAEA_DESCR",
"en": "Pan-Gaia: \"One Earth,\" a massive single continent."
},
{
"key": "TXT_KEY_MAP_SCRIPT_PERFECT_WORLD_DESCR",
"en": "Random map that simulates earth-like plate tectonics, geostrophic and monsoon winds and rainfall."
},
{
"key": "TXT_KEY_MAP_SCRIPT_RANDOM_DESCR",
"en": "Map script which allows to randomly select a map script between Earth3, Erebus, Fractured World, Inland Sea, Medium and Small, PlanetFall, Sea Highlands and Tectonics."
},
{
"key": "TXT_KEY_MAP_SCRIPT_RING_WORLD_DESCR",
"en": "Random map based on Larry Niven's famous 'Ringworld' novel. It creates a thin (16 tiles wide) but long map with artificial landmasses and climate."
},
{
"key": "TXT_KEY_MAP_SCRIPT_SEA_HIGHLANDS_DESCR",
"en": "Highlands, valleys and mountain ranges with several bigger lakes."
},
{
"key": "TXT_KEY_MAP_SCRIPT_TECTONICS_DESCR",
"en": "Produces mountain ranges, and simulates plate tectonics, giving more realistic/earthlike terrain (mountain ranges, mountains near coasts like the Andes, or between subcontinents like the Himalaia)."
},
{
"key": "TXT_KEY_MAP_SCRIPT_TERRA_DESCR",
"en": "Terra generates random land masses similar to those of the planet Earth. All players begin in the Old World. These maps are extra large!"
},
